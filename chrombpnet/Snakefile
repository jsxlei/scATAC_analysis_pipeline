include: "rules/prediction.smk"


# Union negatives
def list_negatives(wildcards):
    if USE_UNION_PEAKS:
        return expand(output_config["negative_dir"] + "/{fold}_negatives.bed", fold=FOLDS)
    return expand(output_config["negative_dir"] + "/{cell_type}/{fold}_negatives.bed", cell_type=CELLTYPES, fold=FOLDS)

def list_models(wildcards):
    return expand(output_config["model_dir"]+"/{cell_type}/{fold}/models/chrombpnet_nobias.h5", cell_type=CELLTYPES, fold=config['fold'])

def list_shap(wildcards):
    return expand(output_config["shap_dir"] + "/{cell_type}/{fold}.{head}_scores.bw", cell_type=CELLTYPES, fold=config['fold'], head=config['head'])

def list_average_shap(wildcards):
    return expand(output_config["shap_dir"] + "/{cell_type}/average.{head}.{suffix}", cell_type=CELLTYPES, head=config['head'], suffix=['h5', 'bw'])

def list_modisco(wildcards):
    return expand(output_config["modisco_dir"] + "/{cell_type}/{head}_modisco.h5", cell_type=CELLTYPES, head=config['head'])

def list_modisco_motif(wildcards):
    return expand(output_config["modisco_dir"] + "/{cell_type}/modisco/{head}//motifs.html", cell_type=CELLTYPES, head=config['head'])

def list_hitcaller(wildcards):
    return expand(output_config["hitcaller_dir"] + "/{cell_type}/{head}/hits.bed.gz", cell_type=CELLTYPES, head=config['head'])

def list_predictions(wildcards):
    return expand(output_config["prediction_dir"] + "/{cell_type}/pred_chrombpnet_nobias.bw", cell_type=CELLTYPES)



shell.prefix("source {workflow.basedir}/scripts/env_setup.sh")

rule all:
    input:
        # list_average_shap,
        list_modisco,
        list_hitcaller,
        list_predictions


onsuccess:
    _send_pipeline_email("success")


onerror:
    _send_pipeline_email("failure")








