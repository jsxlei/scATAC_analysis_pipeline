# from snakemake.utils import min_version
# min_version("5.4")

configfile: "config.yaml"


import os
genome_build = config["genome_build"]
genome_config = {i: os.path.join(config['genome_dir'], genome_build, config["genome"][genome_build][i]) for i in config["genome"][genome_build]}
output_config = {i: os.path.join(config['out_dir'], config["out"][i]) for i in config["out"]}
motif_config = {i: os.path.join(config['motif_dir'], config["motif"][i]) for i in config["motif"]}


CELLTYPES = [
        fname.replace(config["peak_suffix"], "")
        for fname in os.listdir(config["peak_dir"])
        if fname.endswith(config["peak_suffix"])
    ]

FOLDS=config['fold']

include: "rules/negatives.smk"
include: "rules/train.smk"
include: "rules/deepshap.smk"
include: "rules/average_shap.smk"
include: "rules/modisco.smk"
include: "rules/make_contrib_bw.smk"
include: "rules/prediction.smk"
include: "rules/hitcaller.smk"
include: "rules/footprint.smk"
include: "rules/make_datahub.smk"




# Union negatives
def list_negatives(wildcards):   
    return expand(output_config['negative_dir']+"/{fold}_negatives.bed", fold=FOLDS)

def list_models(wildcards):
    return expand(output_config["model_dir"]+"/{cell_type}/{fold}/models/chrombpnet_nobias.h5", cell_type=CELLTYPES, fold=config['fold'])

def list_shap(wildcards):
    return expand(output_config["shap_dir"] + "/{cell_type}/{fold}.{head}_scores.bw", cell_type=CELLTYPES, fold=config['fold'], head=config['head'])

def list_modisco(wildcards):
    return expand(output_config["modisco_dir"] + "/{cell_type}/{head}_modisco.h5", cell_type=CELLTYPES, head=config['head'])

def list_hitcaller(wildcards):
    return expand(output_config["hitcaller_dir"] + "/{cell_type}/{head}/hits.bed.gz", cell_type=CELLTYPES, head=config['head'])



shell.prefix("source scripts/env_setup.sh")

rule all:
    input: 
        list_models,
        list_shap,
        list_modisco,
        list_hitcaller




















