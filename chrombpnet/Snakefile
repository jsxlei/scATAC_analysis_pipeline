import datetime as dt
import os
import smtplib
from email.message import EmailMessage

genome_build = config["genome_build"]
genome_config = {i: os.path.join(config['genome_dir'], genome_build, config["genome"][genome_build][i]) for i in config["genome"][genome_build]}
output_config = {i: os.path.join(config['out_dir'], config["out"][i]) for i in config["out"]}
motif_config = {i: os.path.join(config['motif_dir'], config["motif"][i]) for i in config["motif"]}

# Backward-compatible defaults so old configs (without new keys) still work.
DEFAULT_OUT_SUBDIRS = {
    "model_dir": "models",
    "negative_dir": "negatives",
    "modisco_dir": "modisco",
    "shap_dir": "shap",
    "hitcaller_dir": "hitcaller",
    "prediction_dir": "predictions",
}
for _key, _subdir in DEFAULT_OUT_SUBDIRS.items():
    output_config.setdefault(_key, os.path.join(config["out_dir"], _subdir))

USE_UNION_PEAKS = config.get("use_union_peak", False)


def _should_send_email(final_state):
    email_cfg = config.get("email", {})
    if not email_cfg.get("enabled", False):
        return False
    policy = (email_cfg.get("on", "success_and_failure") or "").strip().lower()
    if policy == "success_only":
        return final_state == "success"
    if policy == "failure_only":
        return final_state == "failure"
    return True


def _send_pipeline_email(final_state):
    if not _should_send_email(final_state):
        return

    email_cfg = config.get("email", {})
    smtp_host = email_cfg.get("smtp_host", "")
    smtp_port = int(email_cfg.get("smtp_port", 587))
    smtp_starttls = bool(email_cfg.get("smtp_starttls", True))
    smtp_username = email_cfg.get("smtp_username", "")
    smtp_password = os.environ.get(email_cfg.get("smtp_password_env", "CHROMBPNET_SMTP_PASSWORD"), "")
    from_email = email_cfg.get("from_email", "")
    to_emails = email_cfg.get("to_emails", [])
    if isinstance(to_emails, str):
        to_emails = [x.strip() for x in to_emails.split(",") if x.strip()]

    required = [smtp_host, from_email]
    if not all(required) or not to_emails:
        print("[email] Missing smtp_host/from_email/to_emails; skip email notification.")
        return

    timestamp = dt.datetime.now().isoformat(timespec="seconds")
    subject_prefix = email_cfg.get("subject_prefix", "[ChromBPNet]")
    state_label = "SUCCESS" if final_state == "success" else "FAILED"
    subject = f"{subject_prefix} {state_label} {timestamp}"

    body = [
        f"ChromBPNet workflow status: {state_label}",
        f"Time: {timestamp}",
        f"Output dir: {config['out_dir']}",
    ]
    if final_state == "failure":
        body.append("Check Snakemake logs for failed jobs and rerun to recover.")

    msg = EmailMessage()
    msg["Subject"] = subject
    msg["From"] = from_email
    msg["To"] = ", ".join(to_emails)
    msg.set_content("\n".join(body))

    try:
        with smtplib.SMTP(smtp_host, smtp_port, timeout=60) as server:
            if smtp_starttls:
                server.starttls()
            if smtp_username:
                server.login(smtp_username, smtp_password)
            server.send_message(msg)
        print(f"[email] Sent {state_label} notification to {len(to_emails)} recipient(s).")
    except Exception as err:
        print(f"[email] Failed to send {state_label} notification: {err}")


DISCOVERED_CELLTYPES = sorted([
        fname.replace(config["peak_suffix"], "")
        for fname in os.listdir(config["peak_dir"])
        if fname.endswith(config["peak_suffix"])
    ])

def _parse_config_list(value):
    if value is None:
        return None
    if isinstance(value, str):
        parts = [v.strip() for v in value.split(",")]
        return [v for v in parts if v]
    return list(value)


def _read_value_file(path):
    with open(path) as handle:
        vals = []
        for line in handle:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            vals.extend(line.split())
    return vals


# Priority:
# 1) cell_type (single) from config/CLI
# 2) cell_types (list) from config/CLI
# 3) cell_types_file (one value per line; preserves file order)
# 4) auto-discover from peak_dir (sorted)
single_cell_type = config.get("cell_type")
configured_celltypes = _parse_config_list(config.get("cell_types"))
configured_celltypes_file = config.get("cell_types_file")

if single_cell_type:
    CELLTYPES = [single_cell_type]
elif configured_celltypes:
    CELLTYPES = configured_celltypes
elif configured_celltypes_file:
    CELLTYPES = _read_value_file(configured_celltypes_file)
else:
    CELLTYPES = DISCOVERED_CELLTYPES

if not CELLTYPES:
    raise ValueError("No cell types resolved. Check cell_type/cell_types/cell_types_file or peak_dir.")

cell_type_index = _parse_config_list(config.get("cell_type_index"))
cell_type_index_file = config.get("cell_type_index_file")
if cell_type_index is None and cell_type_index_file:
    cell_type_index = _read_value_file(cell_type_index_file)

if cell_type_index is not None:
    # Support either numeric indices (legacy behavior) or explicit cell-type names.
    try:
        CELLTYPES = [CELLTYPES[int(i)] for i in cell_type_index]
    except (TypeError, ValueError, IndexError):
        invalid = [ct for ct in cell_type_index if ct not in CELLTYPES]
        if invalid:
            raise ValueError(
                f"Invalid cell_type_index={cell_type_index} for {len(CELLTYPES)} cell types: {CELLTYPES}"
            )
        CELLTYPES = list(cell_type_index)

FOLDS=config['fold']

include: "rules/negatives.smk"
include: "rules/train.smk"
